{
    "name": "webnarmin/amphp-websocket-server",
    "description": "Authenticated Amp WebSocket transport runtime with user-aware gateway and control HTTP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "amphp/websocket-server": "^4.0",
        "amphp/http-server-router": "^2.0",
        "amphp/log": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "amphp/websocket-client": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "webnarmin\\AmphpWS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "webnarmin\\AmphpWSTest\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml",
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ],
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
        "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
    }
}
